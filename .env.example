# ============================================================
# Text2SQL PRISM - Environment Configuration
# ============================================================

# --- Databricks Unity Catalog (set these to use Databricks natively) ---
# Leave DATABRICKS_HOST empty to use SQLAlchemy (PostgreSQL/MySQL/SQLite)
DATABRICKS_HOST=                              # e.g. adb-1234567890.12.azuredatabricks.net
DATABRICKS_HTTP_PATH=                         # e.g. /sql/1.0/warehouses/abc123def456
DATABRICKS_TOKEN=                             # Personal access token (or use OAuth below)
DATABRICKS_CLIENT_ID=                         # OAuth M2M client ID (alternative to token)
DATABRICKS_CLIENT_SECRET=                     # OAuth M2M client secret
DATABRICKS_DEFAULT_CATALOG=main              # Default Unity Catalog catalog
DATABRICKS_DEFAULT_SCHEMA=default           # Default schema
DATABRICKS_QUERY_TIMEOUT=600               # Query timeout in seconds

# --- Schema Vector Index (for large databases / Unity Catalog) ---
# Backend: chroma (local, default) | pgvector (production) | in_memory (tests)
SCHEMA_INDEX_BACKEND=chroma
SCHEMA_INDEX_CHROMA_PERSIST_DIR=./data/chroma/schema_index
SCHEMA_INDEX_PG_DSN=                          # postgresql://user:pass@host/db (pgvector)
SCHEMA_INDEX_EMBEDDING_MODEL=all-MiniLM-L6-v2
SCHEMA_INDEX_SEARCH_TOP_K=15

# --- Google AI / ADK ---
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false          # Set true to use Vertex AI instead of Gemini API

# --- LLM Model Configuration ---
ORCHESTRATOR_MODEL=gemini-2.0-flash
SCHEMA_AGENT_MODEL=gemini-2.0-flash
QUERY_ANALYZER_MODEL=gemini-2.5-pro      # Deep Think uses Pro for reasoning
SQL_GENERATOR_MODEL=gemini-2.5-pro
SQL_VALIDATOR_MODEL=gemini-2.0-flash
OPTIMIZER_MODEL=gemini-2.0-flash
FORMATTER_MODEL=gemini-2.0-flash

# --- Database Configuration (Primary) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enterprise_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Additional Database Connections (Multi-tenant) ---
# Format: DB_ALIAS=dialect+driver://user:pass@host:port/dbname
# DB_ANALYTICS=bigquery://project/dataset
# DB_REPORTING=snowflake://user:pass@account/db/schema

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SCHEMA=3600       # Schema cache TTL in seconds
CACHE_TTL_QUERY=300         # Query result cache TTL in seconds

# --- Vector Store (Few-shot Examples) ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
FEW_SHOT_TOP_K=5            # Number of similar examples to retrieve

# --- Deep Think Configuration ---
DEEP_THINK_MAX_ITERATIONS=3
DEEP_THINK_CONFIDENCE_THRESHOLD=0.85
ENABLE_SELF_REFLECTION=true
ENABLE_CHAIN_OF_THOUGHT=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# --- Security ---
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_QUERY_LENGTH=2000
ENABLE_QUERY_SANITIZATION=true
ENABLE_SQL_ALLOWLIST=false          # If true, only allow SELECT statements

# --- MCP (Model Context Protocol) Client ---
# Set MCP_ENABLED=true to connect to a Databricks MCP server.
# The agent will use MCP tools for schema discovery & query execution,
# with the native Databricks SDK and SQLAlchemy as fallbacks.
#
# Option A — stdio (launch a local subprocess):
MCP_ENABLED=false
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=databricks mcp start    # Requires Databricks CLI v0.227+
#
# Option B — SSE (connect to a running MCP server over HTTP):
# MCP_TRANSPORT=sse
# MCP_SERVER_URL=http://localhost:3001/sse
#
# Timeouts
MCP_DISCOVERY_TIMEOUT=10                  # Seconds to wait for tool discovery
MCP_CALL_TIMEOUT=30                       # Seconds per tool call
#
# Tool name overrides (only needed for non-standard MCP servers)
# MCP_TOOL_EXECUTE_QUERY=execute_statement
# MCP_TOOL_LIST_CATALOGS=list_catalogs
# MCP_TOOL_LIST_SCHEMAS=list_schemas
# MCP_TOOL_LIST_TABLES=list_tables
# MCP_TOOL_GET_TABLE=get_table
# MCP_TOOL_SEARCH_TABLES=search_tables

# --- Observability ---
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json or text

# --- Feature Flags ---
ENABLE_QUERY_CACHING=true
ENABLE_SCHEMA_CACHING=true
ENABLE_FEW_SHOT_EXAMPLES=true
ENABLE_QUERY_OPTIMIZATION=true
ENABLE_RESULT_EXPLANATION=true
MAX_ROWS_RETURN=1000
