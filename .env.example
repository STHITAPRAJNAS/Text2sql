# ============================================================
# Text2SQL PRISM - Environment Configuration
# ============================================================

# --- Google AI / ADK ---
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false          # Set true to use Vertex AI instead of Gemini API

# --- LLM Model Configuration ---
ORCHESTRATOR_MODEL=gemini-2.0-flash
SCHEMA_AGENT_MODEL=gemini-2.0-flash
QUERY_ANALYZER_MODEL=gemini-2.5-pro      # Deep Think uses Pro for reasoning
SQL_GENERATOR_MODEL=gemini-2.5-pro
SQL_VALIDATOR_MODEL=gemini-2.0-flash
OPTIMIZER_MODEL=gemini-2.0-flash
FORMATTER_MODEL=gemini-2.0-flash

# --- Database Configuration (Primary) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enterprise_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Additional Database Connections (Multi-tenant) ---
# Format: DB_ALIAS=dialect+driver://user:pass@host:port/dbname
# DB_ANALYTICS=bigquery://project/dataset
# DB_REPORTING=snowflake://user:pass@account/db/schema

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SCHEMA=3600       # Schema cache TTL in seconds
CACHE_TTL_QUERY=300         # Query result cache TTL in seconds

# --- Vector Store (Few-shot Examples) ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
FEW_SHOT_TOP_K=5            # Number of similar examples to retrieve

# --- Deep Think Configuration ---
DEEP_THINK_MAX_ITERATIONS=3
DEEP_THINK_CONFIDENCE_THRESHOLD=0.85
ENABLE_SELF_REFLECTION=true
ENABLE_CHAIN_OF_THOUGHT=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# --- Security ---
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_QUERY_LENGTH=2000
ENABLE_QUERY_SANITIZATION=true
ENABLE_SQL_ALLOWLIST=false          # If true, only allow SELECT statements

# --- Observability ---
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json or text

# --- Feature Flags ---
ENABLE_QUERY_CACHING=true
ENABLE_SCHEMA_CACHING=true
ENABLE_FEW_SHOT_EXAMPLES=true
ENABLE_QUERY_OPTIMIZATION=true
ENABLE_RESULT_EXPLANATION=true
MAX_ROWS_RETURN=1000
